{
  "name": "better-notion-mcp",
  "description": "Markdown-first Notion API integration — 10 tools (8 composite + 2 infra), 53 actions",
  "version": "3.7.2",
  "userConfig": {
    "NOTION_TOKEN": {
      "type": "string",
      "title": "Notion integration token",
      "description": "From https://www.notion.so/my-integrations (starts with ntn_)",
      "sensitive": true,
      "required": true
    }
  },
  "author": {
    "name": "one2agi",
    "url": "https://github.com/one2agi"
  },
  "homepage": "https://github.com/one2agi/better-notion-mcp",
  "mcpServers": {
    "better-notion-mcp": {
      "command": "npx",
      "args": ["--yes", "@faize555/better-notion-mcp@latest"],
      "env": {
        "MCP_TRANSPORT": "stdio",
        "NOTION_TOKEN": "${user_config.NOTION_TOKEN}"
      }
    }
  }
}
